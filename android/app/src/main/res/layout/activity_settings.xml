<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/hintergrund">

<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/weg_label"
        android:textSize="16sp"
        android:paddingBottom="8dp" />

    <RadioGroup
        android:id="@+id/wegwahl"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <RadioButton
            android:id="@+id/weg_station"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/weg_station" />

        <RadioButton
            android:id="@+id/weg_spiegel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/weg_spiegel" />
    </RadioGroup>

    <!-- Weg 1: Station im Tailnet -->
    <EditText
        android:id="@+id/adresse"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:inputType="textUri"
        android:hint="@string/adresse_hint"
        android:autofillHints=""
        android:textSize="18sp"
        android:layout_marginTop="16dp" />

    <!-- Weg 2: öffentlicher Spiegel -->
    <LinearLayout
        android:id="@+id/spiegel_block"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="16dp">

        <EditText
            android:id="@+id/spiegel_adresse"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textUri"
            android:hint="@string/spiegel_hint"
            android:autofillHints=""
            android:textSize="18sp" />

        <EditText
            android:id="@+id/foto_token"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textPassword"
            android:hint="@string/token_hint"
            android:autofillHints=""
            android:textSize="18sp"
            android:layout_marginTop="12dp" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/adresse_hilfe"
        android:textSize="13sp"
        android:paddingTop="16dp"
        android:paddingBottom="24dp" />

    <Button
        android:id="@+id/speichern"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/speichern" />

</LinearLayout>
</ScrollView>
