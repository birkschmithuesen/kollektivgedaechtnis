<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/hintergrund">

<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/weg_label"
        android:textSize="16sp"
        android:paddingBottom="8dp" />

    <RadioGroup
        android:id="@+id/wegwahl"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <RadioButton
            android:id="@+id/weg_station"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/weg_station" />

        <RadioButton
            android:id="@+id/weg_spiegel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/weg_spiegel" />
    </RadioGroup>

    <!-- Weg 1: Station im Tailnet -->
    <EditText
        android:id="@+id/adresse"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:inputType="textUri"
        android:hint="@string/adresse_hint"
        android:autofillHints=""
        android:textSize="18sp"
        android:layout_marginTop="16dp" />

    <!-- Weg 2: öffentlicher Spiegel -->
    <LinearLayout
        android:id="@+id/spiegel_block"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="16dp">

        <EditText
            android:id="@+id/spiegel_adresse"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textUri"
            android:hint="@string/spiegel_hint"
            android:autofillHints=""
            android:textSize="18sp" />

        <!--
          Feld + Knopf nebeneinander. Der Knopf ist der eigentliche Weg:
          Birk am Geraet, 2026-09-01 — im Token-Feld erschien beim langen
          Druecken kein „Einfuegen", im Adressfeld darueber schon. Woran das
          auf DIESEM Geraet liegt, laesst sich aus der Ferne nicht klaeren
          (Tastatur, Hersteller-Aufsatz, Android-Fassung).
          Deshalb nicht weiter am Eingabetyp herumraten, sondern die
          Zwischenablage selbst auslesen: `ClipboardManager` haengt weder an
          der Tastatur noch am Kontextmenue und tut es auf jedem Geraet.
        -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="12dp">

            <EditText
                android:id="@+id/foto_token"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:inputType="textVisiblePassword"
                android:hint="@string/token_hint"
                android:autofillHints=""
                android:textSize="18sp" />

            <Button
                android:id="@+id/token_einfuegen"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/einfuegen"
                android:layout_marginStart="8dp" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/adresse_hilfe"
        android:textSize="13sp"
        android:paddingTop="16dp"
        android:paddingBottom="24dp" />

    <Button
        android:id="@+id/speichern"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/speichern" />

</LinearLayout>
</ScrollView>
