<?xml version="1.0" encoding="utf-8"?>
<!--
  Ein Sucher, ein großer Auslöser, eine Statuszeile. Der Auslöser ist bewusst
  übergroß (96dp): er wird im Flur von wechselnden Menschen bedient, teils mit
  dem Mikrofon in der anderen Hand.
-->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/hintergrund">

    <androidx.camera.view.PreviewView
        android:id="@+id/sucher"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/status" />

    <!--
      Der Rahmen liegt ueber dem Sucher und deckt sich mit ihm: er zeigt den
      Ausschnitt, den die Station nimmt. Nicht anklickbar
      (`clickable=false`), damit er den Auslöser nicht abfängt.
    -->
    <art.artesmobiles.kg.SucherRahmen
        android:id="@+id/rahmen"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clickable="false"
        app:layout_constraintTop_toTopOf="@id/sucher"
        app:layout_constraintStart_toStartOf="@id/sucher"
        app:layout_constraintEnd_toEndOf="@id/sucher"
        app:layout_constraintBottom_toBottomOf="@id/sucher" />

    <!--
      Die Vorschau des fertigen Portraits, formatfuellend ueber dem Sucher.

      Bis 2026-09-01 hing sie als 140dp-Kachel in der Ecke, damit sie den
      Sucher fuer das naechste Foto nicht verstellt. Birk am Booth: „soll aber
      Vollbild angezeigt werden" — am Geraet ist auf einer Briefmarke nicht zu
      beurteilen, ob der Ausschnitt sitzt, und genau dafuer ist sie da.

      `fitCenter` statt `centerCrop`: das Portrait ist quadratisch, der Schirm
      nicht. Ein Crop wuerde ausgerechnet den Rand abschneiden, an dem man
      sieht, ob der Zuschnitt zu eng sitzt. Der schwarze Hintergrund ist derselbe
      wie auf der Projektionswand, das Urteil faellt also im richtigen Kontext.

      Antippen blendet sie weg und gibt den Sucher frei.
    -->
    <ImageView
        android:id="@+id/vorschau"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        android:background="@android:color/black"
        android:scaleType="fitCenter"
        android:clickable="true"
        android:focusable="true"
        android:contentDescription="@string/vorschau_beschreibung"
        app:layout_constraintTop_toTopOf="@id/sucher"
        app:layout_constraintStart_toStartOf="@id/sucher"
        app:layout_constraintEnd_toEndOf="@id/sucher"
        app:layout_constraintBottom_toBottomOf="@id/sucher" />

    <ImageButton
        android:id="@+id/einstellungen"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_margin="12dp"
        android:background="@android:color/transparent"
        android:src="@android:drawable/ic_menu_preferences"
        android:contentDescription="@string/settings_title"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/status"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:padding="12dp"
        android:gravity="center"
        android:textSize="15sp"
        android:text="@string/start"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/ausloeser" />

    <Button
        android:id="@+id/ausloeser"
        android:layout_width="0dp"
        android:layout_height="96dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginTop="16dp"
        android:textSize="22sp"
        android:text="@string/ausloeser"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/interview" />

    <!--
      Interview starten / beenden (Birk, 2026-09-01: „analog zu dem Mikrofon
      an außen ... Start/Stopp halt über das Handy haben").

      UNTER dem Auslöser und flacher (64dp gegen 96dp): Der Auslöser ist der
      Knopf, der im Flur am häufigsten und oft mit einer Hand bedient wird —
      er behält den Daumenplatz und seine Größe. Ein gleich großer zweiter
      Knopf darunter würde beim blinden Danebengreifen ein Interview beenden,
      und das ist der teuerste Fehlgriff, den diese App anbieten kann.

      Die Beschriftung wechselt zwischen „Interview starten" und „Interview
      beenden" — was der Knopf tut, hängt am Zustand der STATION, nicht an
      einem Merker in der App (siehe MainActivity.zeigeZustand).
    -->
    <Button
        android:id="@+id/interview"
        android:layout_width="0dp"
        android:layout_height="64dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="16dp"
        android:textSize="18sp"
        android:text="@string/interview_starten"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
